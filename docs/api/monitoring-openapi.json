{
  "openapi": "3.0.1",
  "info": {
    "title": "ATM Platform Monitoring API",
    "description": "Receives heartbeats, health and errors from ATM terminals.",
    "version": "v1"
  },
  "paths": {
    "/api/heartbeat": {
      "post": {
        "tags": [
          "ATM.Monitoring.Api"
        ],
        "summary": "Record a terminal heartbeat.",
        "operationId": "PostHeartbeat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/health": {
      "post": {
        "tags": [
          "ATM.Monitoring.Api"
        ],
        "summary": "Record the latest health report of a terminal.",
        "operationId": "PostHealth",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HealthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/errors": {
      "post": {
        "tags": [
          "ATM.Monitoring.Api"
        ],
        "summary": "Record an error raised on a terminal.",
        "operationId": "PostError",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/terminals": {
      "get": {
        "tags": [
          "ATM.Monitoring.Api"
        ],
        "summary": "List known terminals with their latest state.",
        "operationId": "GetTerminals",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorRequest": {
        "type": "object",
        "properties": {
          "terminalId": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "occurredUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "HealthEntryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "lastRunUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "HealthRequest": {
        "type": "object",
        "properties": {
          "terminalId": {
            "type": "string",
            "nullable": true
          },
          "overall": {
            "type": "string",
            "nullable": true
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthEntryDto"
            },
            "nullable": true
          },
          "sentUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "HeartbeatRequest": {
        "type": "object",
        "properties": {
          "terminalId": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "string",
            "nullable": true
          },
          "machine": {
            "type": "string",
            "nullable": true
          },
          "environment": {
            "type": "string",
            "nullable": true
          },
          "sentUtc": {
            "type": "string",
            "format": "date-time"
          },
          "uptimeSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "errorTotal": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    }
  ]
}