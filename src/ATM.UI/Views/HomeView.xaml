<UserControl x:Class="ATM.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="{Binding Heading}" FontSize="64" FontWeight="SemiBold"
               Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" />
    <TextBlock Text="{Binding Prompt}" FontSize="28" Margin="0,16,0,0"
               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
