<UserControl x:Class="ATM.UI.Views.CustomerServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="48">
    <StackPanel Visibility="{Binding IsChoosing, Converter={StaticResource Converter.BoolToVisibility}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Prompt}" FontSize="48" FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" />
      <TextBlock Text="Cash withdrawal" FontSize="24" Margin="0,32,0,12"
                 Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" />
      <ItemsControl ItemsSource="{Binding QuickAmounts}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" ContentStringFormat="{}{0:0}" MinWidth="140" MinHeight="72" FontSize="28" Margin="8"
                    Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Style="{StaticResource Style.Button}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
        <Button Content="Balance" Command="{Binding BalanceCommand}" MinWidth="200" MinHeight="72" FontSize="24" Margin="8"
                Style="{StaticResource Style.Button}" />
        <Button Content="Mini statement" Command="{Binding MiniStatementCommand}" MinWidth="200" MinHeight="72" FontSize="24" Margin="8"
                Style="{StaticResource Style.Button}" />
        <Button Content="Change PIN" Command="{Binding ChangePinCommand}" MinWidth="200" MinHeight="72" FontSize="24" Margin="8"
                Style="{StaticResource Style.Button}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Visibility="{Binding IsWorking, Converter={StaticResource Converter.BoolToVisibility}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Prompt}" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{StaticResource Brush.Text}" MaxWidth="800" />
      <ProgressBar IsIndeterminate="True" Height="12" Width="400" Margin="0,32,0,32" Foreground="{StaticResource Brush.Accent}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="200" MinHeight="64" FontSize="24"
              HorizontalAlignment="Center" Style="{StaticResource Style.Button}" />
    </StackPanel>

    <StackPanel Visibility="{Binding IsResult, Converter={StaticResource Converter.BoolToVisibility}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="{Binding ResultTitle}" FontSize="48" FontWeight="SemiBold" TextAlignment="Center"
                 Foreground="{StaticResource Brush.Text}" />
      <TextBlock Text="{Binding ResultMessage}" FontSize="26" Margin="0,16,0,16" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{StaticResource Brush.TextMuted}" MaxWidth="800" />
      <ItemsControl ItemsSource="{Binding ResultLines}" HorizontalAlignment="Center">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="24" Margin="0,4" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Done" Command="{Binding DoneCommand}" MinWidth="200" MinHeight="64" FontSize="24" Margin="0,32,0,0"
              HorizontalAlignment="Center" Style="{StaticResource Style.Button}" />
    </StackPanel>
  </Grid>
</UserControl>
