<UserControl x:Class="ATM.UI.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Device self-test" FontSize="32" FontWeight="SemiBold"
               Foreground="{StaticResource Brush.Text}" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16">
      <Button Content="Run self-test" Command="{Binding RunSelfTestCommand}"
              Style="{StaticResource Style.Button}" />
      <TextBlock Text="Overall:" VerticalAlignment="Center" Margin="24,0,8,0" FontSize="18"
                 Foreground="{StaticResource Brush.TextMuted}" />
      <TextBlock Text="{Binding Overall}" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.Text}" />
    </StackPanel>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
              Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Text}"
              RowBackground="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
              FontSize="16">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="200" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="3" Margin="0,24,0,0">
      <StackPanel Orientation="Horizontal" Visibility="{Binding CanUseSupervisorMode, Converter={StaticResource Converter.BoolToVisibility}}">
        <PasswordBox x:Name="PasscodeBox" Width="200" MinHeight="48" FontSize="18" Margin="0,0,16,0" />
        <Button Content="Supervisor login" Click="OnSupervisorLoginClick" Style="{StaticResource Style.Button}" />
        <Button Content="Exit supervisor" Command="{Binding ExitSupervisorCommand}" Style="{StaticResource Style.Button}" Margin="16,0,0,0" />
        <TextBlock Text="{Binding SupervisorMessage}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="16"
                   Foreground="{StaticResource Brush.TextMuted}" />
      </StackPanel>

      <StackPanel Visibility="{Binding IsSupervisor, Converter={StaticResource Converter.BoolToVisibility}}" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="System health:" FontSize="18" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding HealthOverall}" FontSize="18" FontWeight="SemiBold" Margin="8,0,24,0"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
          <Button Content="Refresh" Command="{Binding RefreshHealthCommand}" Style="{StaticResource Style.Button}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Health}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" MaxHeight="220" Margin="0,12,0,0" FontSize="16"
                  Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Text}"
                  RowBackground="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="160" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
            <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="110" />
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Reversals waiting for the host" FontSize="18" Margin="0,16,0,0" Foreground="{StaticResource Brush.TextMuted}" />
        <DataGrid ItemsSource="{Binding Reversals}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" MaxHeight="180" Margin="0,8,0,0" FontSize="16"
                  Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Text}"
                  RowBackground="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Transaction" Binding="{Binding Transaction}" Width="300" />
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
            <DataGridTextColumn Header="Tries" Binding="{Binding Attempts}" Width="70" />
            <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="150" />
            <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
